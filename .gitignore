# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version
build/
dist/
*.spec.bak
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

# Node / web
web/node_modules/
web/dist/
web/.vite/
web/test-results/
web/playwright-report/
*.tsbuildinfo

# Generated web bundle that ships inside the Python package (built by `npm run build`)
src/bsmm/web/*
!src/bsmm/web/.gitkeep

# Runtime data - never commit
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
secret.key
.env
.env.*
!.env.example

# Logs / temp
*.log
logs/
*.tmp

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Release artefacts
*.exe
*.msi
*.dmg
*.deb
*.rpm
*.AppImage
