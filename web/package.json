{
  "name": "bsmm-web",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "description": "Web interface for Bitcoin Solo Miner Monitor. Built into ../src/bsmm/web and served by the Python app.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:fast": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "shots": "node scripts/make-screenshots.mjs",
    "test:tooling": "node --test scripts/tooling.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "lucide-vue-next": "1.0.0",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.44",
    "vue-draggable-plus": "0.6.1",
    "vue-echarts": "8.3.2",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "happy-dom": "21.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
